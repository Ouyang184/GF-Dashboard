# Copy to .env and adjust for this machine. All values are optional --
# omitted ones fall back to the same defaults the Electron app has always
# used, so this file only needs entries that differ on the shared server.

# Port the web app listens on.
MASTERCARD_SERVER_PORT=4100

# Ollama must be installed and running on THIS machine (the server), not on
# individual users' PCs -- the browser never talks to Ollama directly.
MASTERCARD_OLLAMA_HOST=http://127.0.0.1:11434
MASTERCARD_OLLAMA_MODEL=qwen3.5:9b

# Where the Teams OnFloor log entry should say it was written to.
MASTERCARD_ONFLOOR_DESTINATION=Teams · MasterCard_OnFloor.xlsx · Table2

# JSON array of { "name": ..., "path": ... } folders to search. Only needed
# if this server should search different network paths than the defaults
# baked into mastercard-core/core.cjs.
# MASTERCARD_SEARCH_ROOTS=[{"name":"Molding Mastercards","path":"I:\\Department Files\\Molding\\Molding Mastercards"}]
